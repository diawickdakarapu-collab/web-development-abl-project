<!DOCTYPE html>
<html>
<head>
<title>Business Analytics Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: Arial,sans-serif;
  background: #f1f3f8;
  color: #222;
}
.container {
  display: grid;
  grid-template-columns: 220px 1fr;
  min-height: 100vh;
}
.sidebar {
  background: #202b46;
  color: white;
  padding: 25px 15px;
}
.sidebar h2 {
  margin-bottom: 30px;
}
.sidebar a {
  display: block;
  color: white;
  text-decoration: none;
  padding: 15px 10px;
  border-radius: 6px;
}
.sidebar a:hover {
  background: #394b70;
}
main {
  padding: 30px;
  min-width: 0;
}
header {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 30px;
}
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
  gap: 20px;
}
.card {
  background: white;
  padding: 25px;
  border-radius: 10px;
  box-shadow: 0 2px 10px #ddd;
}
.card h3 {
  color: #777;
  font-size: 15px;
}
.card p {
  font-size: 27px;
  font-weight: bold;
  margin-top: 15px;
  color: #344b86;
}
.charts {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  margin-top: 25px;
}
.chart-box {
  background: white;
  padding: 20px;
  border-radius: 10px;
  min-width: 0;
}
.chart-box h3 {
  margin-bottom: 20px;
}
.chart-box canvas {
  max-height: 300px;
}
.activity {
  background: white;
  margin-top: 25px;
  padding: 20px;
  border-radius: 10px;
  overflow-x: auto;
}
table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 15px;
  min-width: 450px;
}
td,th {
  padding: 15px;
  border-bottom: 1px solid #ddd;
  text-align: left;
}
th {
  color: #344b86;
}
@media(max-width:800px) {
  .container {
    grid-template-columns: 1fr;
  }
  .sidebar {
    padding: 15px;
  }
  .sidebar h2 {
    margin-bottom: 10px;
  }
  .sidebar a {
    display: inline-block;
    padding: 10px;
  }
  .charts {
    grid-template-columns: 1fr;
  }
}
@media(max-width:500px) {
  main {padding: 15px;}
  header {flex-direction: column;}
}
</style>
</head>
<body>

<div class="container">

<aside class="sidebar">
<h2>MyBusiness</h2>
<a href="#overview">Dashboard</a>
<a href="#sales">Sales</a>
<a href="#revenue">Revenue</a>
<a href="#users">Users</a>
<a href="#activity">Activities</a>
</aside>

<main>

<header>
<h1>Business Dashboard</h1>
<p>Welcome, Admin!</p>
</header>

<section class="cards" id="overview">

<div class="card">
<h3>Total Revenue</h3>
<p>₹2,50,000</p>
</div>

<div class="card" id="users">
<h3>Total Users</h3>
<p>5,240</p>
</div>

<div class="card" id="sales">
<h3>Total Sales</h3>
<p>1,250</p>
</div>

<div class="card">
<h3>Growth Rate</h3>
<p>24.8%</p>
</div>

</section>

<section class="charts" id="revenue">

<div class="chart-box">
<h3>Monthly Revenue</h3>
<canvas id="salesChart"></canvas>
</div>

<div class="chart-box">
<h3>Sales Performance</h3>
<canvas id="pieChart"></canvas>
</div>

</section>

<section class="activity" id="activity">
<h2>Recent Activities</h2>

<table>
<tr>
<th>Customer</th>
<th>Activity</th>
<th>Amount</th>
<th>Status</th>
</tr>

<tr>
<td>Rahul</td>
<td>New Purchase</td>
<td>₹5,000</td>
<td>Completed</td>
</tr>

<tr>
<td>Priya</td>
<td>Subscription</td>
<td>₹2,000</td>
<td>Completed</td>
</tr>

<tr>
<td>Arjun</td>
<td>Product Order</td>
<td>₹3,500</td>
<td>Pending</td>
</tr>

<tr>
<td>Sneha</td>
<td>New Purchase</td>
<td>₹4,000</td>
<td>Completed</td>
</tr>

</table>
</section>

</main>
</div>

<script>
new Chart(document.getElementById("salesChart"), {
  type: "bar",
  data: {
    labels: ["Jan","Feb","Mar","Apr","May","Jun"],
    datasets: [{
      label: "Revenue (₹)",
      data: [30000,45000,38000,60000,75000,90000],
      backgroundColor: "#596eea"
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: true
  }
});

new Chart(document.getElementById("pieChart"), {
  type: "doughnut",
  data: {
    labels: ["Products","Services","Subscriptions"],
    datasets: [{
      data: [50,30,20],
      backgroundColor: [
        "#596eea",
        "#35b7a2",
        "#f4ae48"
      ]
    }]
  },
  options: {
    responsive: true
  }
});
</script>

</body>
</html>
