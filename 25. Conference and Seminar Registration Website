!DOCTYPE html>
<html>
<head>
<title>Tech Conference 2026</title>
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: Arial, sans-serif;
  background: #f4f6ff;
  color: #222;
}
header {
  background: #24135f;
  color: white;
  padding: 20px;
  text-align: center;
}
nav {
  background: #38218c;
  padding: 15px;
  text-align: center;
}
nav a {
  color: white;
  margin: 15px;
  text-decoration: none;
}
.hero {
  background: linear-gradient(120deg,#352078,#7955d9);
  color: white;
  text-align: center;
  padding: 75px 20px;
}
.hero h1 {
  font-size: 40px;
  margin-bottom: 15px;
}
section {
  padding: 40px 8%;
}
h2 {
  text-align: center;
  color: #352078;
  margin-bottom: 25px;
}
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
  gap: 20px;
}
.card {
  background: white;
  padding: 25px;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 3px 12px #ccc;
}
.card h3 {
  color: #5636ae;
  margin-bottom: 10px;
}
table {
  width: 100%;
  border-collapse: collapse;
  background: white;
}
th,td {
  padding: 15px;
  border: 1px solid #ddd;
  text-align: center;
}
th {
  background: #352078;
  color: white;
}
form {
  max-width: 500px;
  margin: auto;
  background: white;
  padding: 25px;
  border-radius: 12px;
}
input,select,button {
  width: 100%;
  padding: 12px;
  margin: 10px 0;
  border: 1px solid #ccc;
  border-radius: 6px;
}
button {
  background: #5636ae;
  color: white;
  border: none;
  cursor: pointer;
}
button:hover {
  background: #24135f;
}
footer {
  background: #24135f;
  color: white;
  text-align: center;
  padding: 20px;
}
@media(max-width:600px) {
  nav a {display:inline-block;margin:6px;}
  .hero h1 {font-size:28px;}
}
</style>
</head>
<body>

<header>
<h1>TECHNOVATE 2026</h1>
<p>National Technology Conference</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#speakers">Speakers</a>
<a href="#schedule">Schedule</a>
<a href="#register">Register</a>
</nav>

<div class="hero" id="home">
<h1>Future of Technology</h1>
<p>Explore Innovation | Share Knowledge | Build Connections</p>
<br>
<p>December 15-16, 2026 | Vijayawada</p>
</div>

<section>
<h2>About The Conference</h2>
<p style="text-align:center">
TECHNOVATE 2026 is a national conference
focused on Artificial Intelligence, Cloud Computing,
Cybersecurity and Emerging Technologies.
Join experts and students to explore the future.
</p>
</section>

<section id="speakers">
<h2>Keynote Speakers</h2>
<div class="cards">
<div class="card">
<h3>Dr. Ananya Sharma</h3>
<p>AI Research Scientist</p>
<p>Artificial Intelligence</p>
</div>
<div class="card">
<h3>Mr. Rahul Kumar</h3>
<p>Software Engineer</p>
<p>Cloud Computing</p>
</div>
<div class="card">
<h3>Ms. Priya Reddy</h3>
<p>Cybersecurity Expert</p>
<p>Digital Security</p>
</div>
</div>
</section>

<section id="schedule">
<h2>Conference Schedule</h2>
<table>
<tr><th>Time</th><th>Session</th><th>Speaker</th></tr>
<tr><td>9:00 AM</td><td>Inauguration</td><td>Principal</td></tr>
<tr><td>10:00 AM</td><td>Artificial Intelligence</td><td>Dr. Ananya</td></tr>
<tr><td>12:00 PM</td><td>Cloud Computing</td><td>Rahul Kumar</td></tr>
<tr><td>2:00 PM</td><td>Cybersecurity Workshop</td><td>Priya Reddy</td></tr>
<tr><td>4:00 PM</td><td>Closing Ceremony</td><td>Organizers</td></tr>
</table>
</section>

<section>
<h2>Venue Information</h2>
<div class="card">
<h3>ABC Engineering College</h3>
<p>Vijayawada, Andhra Pradesh</p>
<p>Date: December 15-16, 2026</p>
<p>Participation: Students and Professionals</p>
</div>
</section>

<section id="register">
<h2>Conference Registration</h2>
<form onsubmit="register(event)">
<input type="text" id="name" placeholder="Enter Your Name" required>
<input type="email" placeholder="Email Address" required>
<input type="tel" placeholder="Phone Number" required>
<select required>
<option value="">Select Participation Type</option>
<option>Student</option>
<option>Professional</option>
<option>Research Scholar</option>
</select>
<button type="submit">Register Now</button>
</form>
</section>

<footer>
<p>© 2026 TECHNOVATE Conference | All Rights Reserved</p>
</footer>

<script>
function register(event) {
  event.preventDefault();
  let name = document.getElementById("name").value;
  alert("Thank you " + name +
  "! Your registration is successful.");
  event.target.reset();
}
</script>

</body>
</html>
