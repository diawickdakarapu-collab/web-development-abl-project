<!DOCTYPE html>
<html>
<head>
<title>College Fest 2026</title>
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: Arial,sans-serif;
  background: #fff8f1;
}
header {
  background: #a52a52;
  color: white;
  text-align: center;
  padding: 25px;
}
nav {
  background: #6c1737;
  text-align: center;
  padding: 15px;
}
nav a {
  color: white;
  text-decoration: none;
  margin: 15px;
}
.hero {
  background: linear-gradient(120deg,#e74c75,#ff9b44);
  color: white;
  padding: 75px 20px;
  text-align: center;
}
.hero h1 {
  font-size: 45px;
  margin-bottom: 15px;
}
section {
  padding: 40px 8%;
}
h2 {
  color: #a52a52;
  text-align: center;
  margin-bottom: 25px;
}
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
  gap: 20px;
}
.card {
  background: white;
  padding: 25px;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 3px 10px #ddd;
}
.card h3 {
  color: #d43b65;
  margin-bottom: 10px;
}
table {
  width: 100%;
  border-collapse: collapse;
  background: white;
}
td,th {
  padding: 14px;
  border: 1px solid #ddd;
  text-align: center;
}
th {
  background: #a52a52;
  color: white;
}
.rules {
  background: white;
  padding: 25px;
  border-radius: 10px;
  line-height: 2;
}
form {
  max-width: 500px;
  background: white;
  padding: 25px;
  margin: auto;
  border-radius: 12px;
}
input,select,button {
  width: 100%;
  padding: 12px;
  margin: 10px 0;
  border: 1px solid #ccc;
  border-radius: 6px;
}
button {
  background: #a52a52;
  color: white;
  border: none;
  cursor: pointer;
}
footer {
  background: #6c1737;
  color: white;
  text-align: center;
  padding: 20px;
}
@media(max-width:600px) {
  nav a {display:inline-block;margin:6px;}
  .hero h1 {font-size:30px;}
}
</style>
</head>
<body>

<header>
<h1>VIBRANCE 2026</h1>
<p>Annual College Fest</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#events">Events</a>
<a href="#schedule">Schedule</a>
<a href="#rules">Rules</a>
<a href="#register">Register</a>
</nav>

<div class="hero" id="home">
<h1>VIBRANCE 2026</h1>
<h2 style="color:white">Celebrate Talent and Creativity!</h2>
<p>Music | Dance | Technology | Fun</p>
<br>
<p>December 20-21, 2026</p>
</div>

<section>
<h2>About Our Fest</h2>
<p style="text-align:center">
VIBRANCE is our annual college festival
where students showcase their talents through
technical competitions, cultural programs,
workshops and exciting activities.
</p>
</section>

<section id="events">
<h2>Technical Events</h2>
<div class="cards">
<div class="card">
<h3>Code Challenge</h3>
<p>Test your programming skills.</p>
<p>Coordinator: Arjun</p>
</div>
<div class="card">
<h3>Web Design</h3>
<p>Create an innovative website.</p>
<p>Coordinator: Sneha</p>
</div>
<div class="card">
<h3>Quiz Competition</h3>
<p>Show your technical knowledge.</p>
<p>Coordinator: Rahul</p>
</div>
</div>

<h2 style="margin-top:40px">Cultural Events</h2>
<div class="cards">
<div class="card">
<h3>Dance Competition</h3>
<p>Solo and Group Dance</p>
<p>Coordinator: Priya</p>
</div>
<div class="card">
<h3>Singing Competition</h3>
<p>Show your musical talent.</p>
<p>Coordinator: Divya</p>
</div>
<div class="card">
<h3>Fashion Show</h3>
<p>Walk with confidence and style.</p>
<p>Coordinator: Kiran</p>
</div>
</div>
</section>

<section>
<h2>Workshops</h2>
<div class="cards">
<div class="card">
<h3>AI Workshop</h3>
<p>Introduction to Artificial Intelligence.</p>
</div>
<div class="card">
<h3>Robotics Workshop</h3>
<p>Learn robotics and automation.</p>
</div>
<div class="card">
<h3>Photography Workshop</h3>
<p>Learn creative photography.</p>
</div>
</div>
</section>

<section id="schedule">
<h2>Event Schedule</h2>
<table>
<tr><th>Time</th><th>Event</th><th>Venue</th></tr>
<tr><td>9 AM</td><td>Inauguration</td><td>Main Hall</td></tr>
<tr><td>10 AM</td><td>Code Challenge</td><td>Computer Lab</td></tr>
<tr><td>11 AM</td><td>Dance Competition</td><td>Auditorium</td></tr>
<tr><td>1 PM</td><td>AI Workshop</td><td>Seminar Hall</td></tr>
<tr><td>3 PM</td><td>Singing Competition</td><td>Main Stage</td></tr>
<tr><td>5 PM</td><td>Prize Distribution</td><td>Main Stage</td></tr>
</table>
</section>

<section id="rules">
<h2>Participation Rules</h2>
<div class="rules">
<p>1. Students must carry their college ID cards.</p>
<p>2. Participants must register before the event.</p>
<p>3. Follow the instructions of coordinators.</p>
<p>4. Maintain discipline in the campus.</p>
<p>5. Be present at the venue on time.</p>
<p>6. Judges' decisions will be final.</p>
</div>
</section>

<section id="register">
<h2>Fest Registration</h2>
<form onsubmit="register(event)">
<input id="name" type="text" placeholder="Student Name" required>
<input type="email" placeholder="Email Address" required>
<input type="text" placeholder="College Name" required>
<select required>
<option value="">Select Event</option>
<option>Code Challenge</option>
<option>Web Design</option>
<option>Quiz Competition</option>
<option>Dance Competition</option>
<option>Singing Competition</option>
<option>Fashion Show</option>
<option>AI Workshop</option>
</select>
<button type="submit">Submit Registration</button>
</form>
</section>

<footer>
<p>© 2026 VIBRANCE College Fest</p>
<p>Organized by Student Fest Committee</p>
</footer>

<script>
function register(event) {
  event.preventDefault();
  let name = document.getElementById("name").value;
  alert("Congratulations " + name +
  "! Your event registration is successful.");
  event.target.reset();
}
</script>

</body>
</html>
